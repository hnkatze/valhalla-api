# Copy to .env and fill in real values. Never commit .env.

# Shared secret clients must send in the X-API-Key header. Required.
VALHALLA_API_KEY=change-me

# Host port nginx listens on.
NGINX_PORT=80

# Where build-tiles.sh publishes and pull-tiles.sh fetches the tile set (s3://bucket/prefix).
TILES_S3_URI=s3://your-tiles-bucket/valhalla/honduras

# AWS region used by the aws CLI in the tile scripts.
AWS_REGION=us-east-1

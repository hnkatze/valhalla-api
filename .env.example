# Copy to .env and fill in real values. Never commit .env.

# Shared secret clients must send in the X-API-Key header. Required.
VALHALLA_API_KEY=change-me

# CIDR nginx accepts X-Forwarded-For from, so it can recover the real client IP behind a
# load balancer. Loopback disables it for a directly reached host; behind an ALB set the VPC
# CIDR, otherwise the per-IP rate limit collapses into one global bucket.
VALHALLA_TRUSTED_PROXY_CIDR=127.0.0.1

# Host port nginx listens on.
NGINX_PORT=80

# Where build-tiles.sh publishes and pull-tiles.sh fetches the tile set (s3://bucket/prefix).
TILES_S3_URI=s3://your-tiles-bucket/valhalla/honduras

# AWS region used by the aws CLI in the tile scripts.
AWS_REGION=us-east-1
